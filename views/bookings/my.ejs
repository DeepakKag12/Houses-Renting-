<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <h3 class="fw-bold mb-4">My Bookings</h3>
  <% if (success && success.length) { %>
    <div class="alert alert-success text-center"><%= success %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="alert alert-danger text-center"><%= error %></div>
  <% } %>
  <% if (bookings && bookings.length) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% bookings.forEach(booking => { %>
        <div class="col">
          <div class="card booking-card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body d-flex flex-column gap-2">
              <h5 class="card-title mb-2"><%= booking.listing.title %></h5>
              <div class="mb-2 text-secondary small">
                <i class="fa-solid fa-calendar-days me-1"></i> Check-in: <%= new Date(booking.checkin).toLocaleDateString() %><br>
                <i class="fa-solid fa-calendar-days me-1"></i> Check-out: <%= new Date(booking.checkout).toLocaleDateString() %>
              </div>
              <div class="mb-2"><i class="fa-solid fa-user-group me-1"></i> Guests: <%= booking.guests %></div>
              <span class="badge <%= booking.status === 'confirmed' ? 'bg-success' : booking.status === 'cancelled' ? 'bg-danger' : 'bg-warning text-dark' %> mb-2">
                <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
              </span>
              <div class="d-flex gap-2 mt-2">
                <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-primary">View Listing</a>
                <% if (booking.status !== 'cancelled') { %>
                  <button class="btn-cancel-booking" type="button" data-bs-toggle="collapse" data-bs-target="#cancelForm<%= booking._id %>" aria-expanded="false" aria-controls="cancelForm<%= booking._id %>">
                    Cancel Booking
                  </button>
                <% } %>
              </div>
              <% if (booking.status !== 'cancelled') { %>
                <div class="collapse w-100" id="cancelForm<%= booking._id %>">
                  <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="mt-2 d-flex flex-column align-items-start">
                    <input type="text" name="reason" class="form-control mb-2" placeholder="Reason for cancellation" required>
                    <button type="submit" class="btn btn-outline-danger rounded-pill">Confirm Cancel</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-info text-center">You have no bookings yet.</div>
  <% } %>
</div>
