<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <h3 class="fw-bold mb-4">My Bookings</h3>
  <% if (success && success.length) { %>
    <div class="alert alert-success text-center"><%= success %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="alert alert-danger text-center"><%= error %></div>
  <% } %>
  <% if (bookings && bookings.length) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% bookings.forEach(booking => { %>
        <div class="col">
          <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
              <h5 class="card-title"><%= booking.listing.title %></h5>
              <p class="card-text">Check-in: <%= new Date(booking.checkin).toLocaleDateString() %></p>
              <p class="card-text">Check-out: <%= new Date(booking.checkout).toLocaleDateString() %></p>
              <p class="card-text">Guests: <%= booking.guests %></p>
              <span class="badge <%= booking.status === 'confirmed' ? 'bg-success' : booking.status === 'cancelled' ? 'bg-danger' : 'bg-warning text-dark' %>">
                <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
              </span>
              <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-primary rounded-pill mt-2">View Listing</a>
              <% if (booking.status !== 'cancelled') { %>
                <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="mt-2 d-flex flex-column align-items-start">
                  <input type="text" name="reason" class="form-control mb-2" placeholder="Reason for cancellation" required>
                  <button type="submit" class="btn btn-outline-danger rounded-pill">Cancel Booking</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-info text-center">You have no bookings yet.</div>
  <% } %>
</div>
