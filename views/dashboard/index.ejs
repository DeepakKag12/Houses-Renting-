<% layout('/layouts/boilerplate') %>
<div class="container my-5">
  <h3 class="fw-bold mb-4">Host Dashboard</h3>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% analytics.forEach(a => { %>
      <div class="col">
        <div class="card shadow-sm border-0 rounded-4">
          <div class="card-body">
            <h5 class="card-title"><%= a.title %></h5>
            <p class="card-text">Views: <%= a.views %></p>
            <p class="card-text">Bookings: <%= a.bookings %></p>
            <p class="card-text">Earnings: ₹<%= a.earnings.toLocaleString('en-IN') %></p>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <% if (analytics.length === 0) { %>
    <div class="text-center text-muted mt-5">No listings yet.</div>
  <% } %>
</div>
