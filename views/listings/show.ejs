<% layout("/layouts/boilerplate") %>

<!-- Styles -->
<link rel="stylesheet" href="/CSS/rating.css">

<div class="container my-5">
  <div class="card border-0 shadow-sm rounded-4 p-4 mx-auto bg-white" style="max-width: 850px;">

    <% if (listing.image?.url) { %>
      <div class="mx-auto mb-4 text-center" style="max-width: 700px;">
        <img 
          src="<%= listing.image.url %>" 
          alt="<%= listing.title %>" 
          class="img-fluid border"
          style="height: 400px; width: 400px; object-fit: cover; border-radius: 1.2rem;"
        >
      </div>
    <% } %>

    <h2 class="fw-bold text-center text-primary mb-2"><%= listing.title %></h2>
    <p class="text-center text-muted mb-3">by <strong><%= listing.owner.username %></strong></p>
    <p class="text-center fs-6"><%= listing.description %></p>

    <ul class="list-group list-group-flush mb-4 border-top pt-3">
      <li class="list-group-item bg-transparent px-0"><strong>💰 Price:</strong> ₹<%= listing.price %></li>
      <li class="list-group-item bg-transparent px-0"><strong>📍 Location:</strong> <%= listing.location %></li>
      <li class="list-group-item bg-transparent px-0"><strong>🌐 Country:</strong> <%= listing.country %></li>
    </ul>

    <% 
      let totalRating = 0;
      let reviewCount = listing.reviews.length;
      listing.reviews.forEach(r => totalRating += r.rating);
      let avgRating = reviewCount ? (totalRating / reviewCount).toFixed(1) : 'No reviews yet';
    %>
    <div class="text-center mb-4">
      <span class="fs-5 text-warning">⭐ <strong>Average Rating:</strong> <%= avgRating %></span>
      <span class="text-muted"><%= reviewCount ? ` / 5 (${reviewCount} reviews)` : "" %></span>
    </div>

    <% if (reviewCount > 0) { %>
      <div class="mb-4">
        <h5 class="fw-semibold mb-3 text-dark">🗣️ Reviews</h5>
        <ul class="list-unstyled">
          <% listing.reviews.forEach(review => { %>
            <li class="mb-3 border-bottom pb-2">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <span class="text-warning"><%= "★".repeat(review.rating) %></span>
                  <span class="ms-2"><%= review.comment %></span>
                  <br />
                  <small class="text-muted">— <%= review.author?.username || "Unknown" %></small>
                </div>
                <% if (currUser && review.author && review.author._id.toString() === currUser._id.toString()) { %>
                  <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this review?');">
                    <button class="btn btn-sm btn-outline-danger" title="Delete">🗑️</button>
                  </form>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (currUser) { %>
      <div class="mb-4">
        <h5 class="mb-3 text-dark">📝 Leave a Review</h5>
        <form action="/listings/<%= listing._id %>/reviews" method="POST">
          <fieldset class="starability-slot mb-3">
            <legend class="small mb-2">Rate this listing</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked />
            <input type="radio" id="rate1" name="review[rating]" value="1" /><label for="rate1">1 star</label>
            <input type="radio" id="rate2" name="review[rating]" value="2" /><label for="rate2">2 stars</label>
            <input type="radio" id="rate3" name="review[rating]" value="3" /><label for="rate3">3 stars</label>
            <input type="radio" id="rate4" name="review[rating]" value="4" /><label for="rate4">4 stars</label>
            <input type="radio" id="rate5" name="review[rating]" value="5" /><label for="rate5">5 stars</label>
          </fieldset>
          <div class="mb-3">
            <textarea class="form-control shadow-sm" name="review[comment]" rows="2" placeholder="Write your comment..." required></textarea>
          </div>
          <div class="text-end">
            <button type="submit" class="btn btn-primary px-4 rounded-pill">Submit</button>
          </div>
        </form>
      </div>
    <% } %>

    <% if (currUser && currUser._id.toString() === listing.owner._id.toString()) { %>
      <div class="d-flex gap-2 mt-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-success w-50">✏️ Edit</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="w-50" onsubmit="return confirm('Are you sure you want to delete this listing?');">
          <button type="submit" class="btn btn-outline-danger w-100">🗑️ Delete</button>
        </form>
      </div>
    <% } %>

    <!-- Map Section -->
    <div class="mx-auto mt-5" style="max-width: 700px;">
      <h4 class="mb-3">📍 Where you’ll be</h4>
      <div id="map" style="height: 400px; border-radius: 1.2rem; overflow: hidden;"></div>
    </div>

  </div>
</div>

<!-- Scripts -->
<script>
  mapboxgl.accessToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%- JSON.stringify(listing.geometry?.coordinates || [77.2090, 28.6139]) %>;

  const map = new mapboxgl.Map({
    container: 'map',
    style: 'mapbox://styles/mapbox/streets-v11',
    center: coordinates,
    zoom: 9
  });

  new mapboxgl.Marker().setLngLat(coordinates).addTo(map);
</script>

