<% layout("/layouts/boilerplate") %>

<!-- Link external rating star styling -->
<link rel="stylesheet" href="/CSS/rating.css">

<div class="container my-5">
  <div class="card border-0 shadow rounded-4 p-4 mx-auto" style="max-width: 850px;">

    <!-- Listing image -->
    <% if (listing.image?.url) { %>
      <div class="text-center mb-4">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="img-fluid shadow" style="max-width: 500px; border-radius: 1.5rem;">
      </div>
    <% } %>

    <!-- Title and owner -->
    <h2 class="fw-bold text-primary mb-2 text-center"><%= listing.title %></h2>
    <h4 class="text-center fw-bold text-dark">Owned By: <%= listing.owner.username %></h4>
    <p class="text-muted text-center"><%= listing.description %></p>

    <!-- Listing details -->
    <ul class="list-group list-group-flush mb-4">
      <li class="list-group-item"><strong>Price:</strong> ₹<%= listing.price %></li>
      <li class="list-group-item"><strong>Location:</strong> <%= listing.location %></li>
      <li class="list-group-item"><strong>Country:</strong> <%= listing.country %></li>
    </ul>

    <!-- Calculate and display average rating -->
    <% 
      let totalRating = 0;
      let reviewCount = listing.reviews.length;
      listing.reviews.forEach(r => totalRating += r.rating);
      let avgRating = reviewCount ? (totalRating / reviewCount).toFixed(1) : 'No reviews yet';
    %>
    <h5 class="text-center text-warning mb-4">
      ⭐ Average Rating: <%= avgRating %> <%= reviewCount ? `/ 5 (${reviewCount} reviews)` : "" %>
    </h5>

    <!-- Display all reviews -->
    <% if (reviewCount > 0) { %>
      <div class="mb-4">
        <h5 class="text-dark">🗣️ Reviews</h5>
        <ul class="ps-3 mb-0">
          <% listing.reviews.forEach(review => { %>
            <li class="mb-2 d-flex justify-content-between align-items-center flex-wrap">
              <div>
                <!-- Stars and comment -->
                <span class="text-warning"><%= "★".repeat(review.rating) %></span>
                <span class="text-dark">— <%= review.comment %></span>
                <small class="text-muted ms-2">by <%= review.author?.username || "Unknown" %></small>
              </div>

              <!-- Delete button (only visible to author) -->
              <% if (currUser && review.author && review.author._id.toString() === currUser._id.toString()) { %>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this review?');">
                  <button class="btn btn-sm btn-outline-danger ms-2" type="submit">🗑️</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Show review form if user is logged in -->
    <% if (currUser) { %>
      <div class="mb-4">
        <h5 class="text-dark mb-3">📝 Leave a Review</h5>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
          <!-- Rating stars (styled via external CSS) -->
          <fieldset class="starability-slot">
            <legend>Rate Listing:</legend>

            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>

            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>

            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>

            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>

            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>

          <!-- Comment box -->
          <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea class="form-control" name="review[comment]" id="comment" rows="2" required></textarea>
          </div>

          <!-- Submit button -->
          <div class="text-end">
            <button type="submit" class="btn btn-primary rounded-pill px-4">Submit Review</button>
          </div>
        </form>
      </div>
    <% } %>

    <!-- Edit/Delete options for the owner of listing -->
    <% if (currUser && currUser._id.toString() === listing.owner._id.toString()) { %>
      <div class="d-flex gap-3 mt-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-success flex-fill">✏️ Edit</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this listing?');" class="flex-fill">
          <button type="submit" class="btn btn-outline-danger w-100">🗑️ Delete</button>
        </form>
      </div>
    <% } %>

  </div>
</div>
